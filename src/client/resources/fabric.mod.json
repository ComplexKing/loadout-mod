{
	"schemaVersion": 1,
	"id": "loadout",
	"version": "${version}",
	"name": "Loadout",
	"description": "Manage an instance's mods from inside the game. Toggle mods, switch resource packs live, restart straight back into the server or world you were in, and see what your frame times actually look like. Companion to the Loadout launcher.",
	"authors": [
		"ComplexKing"
	],
	"contact": {
		"homepage": "https://complexking.github.io/loadout/",
		"sources": "https://github.com/ComplexKing/loadout-mod",
		"issues": "https://github.com/ComplexKing/loadout-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/loadout/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.loadout.mod.LoadoutMod"
		],
		"modmenu": [
			"dev.loadout.mod.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "loadout.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.150.0"
	}
}
